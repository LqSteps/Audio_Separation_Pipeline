FROM nvidia/cuda:12.6.0-devel-ubuntu22.04

RUN apt update && apt install -y \
    python3 \
    python3-venv \
    rsync \
    openssh-client \
    && rm -rf /var/lib/apt/lists/*

COPY bin/ffmpeg /usr/local/bin/ffmpeg
COPY bin/ffprobe /usr/local/bin/ffprobe
RUN chmod +x /usr/local/bin/ffmpeg /usr/local/bin/ffprobe

WORKDIR /app
COPY . .

RUN python3 -m venv .venv && \
    .venv/bin/pip install -U pip setuptools wheel && \
    .venv/bin/pip install torch torchaudio --index-url https://download.pytorch.org/whl/cu121 && \
    .venv/bin/pip install -U demucs && \
    .venv/bin/pip install soundfile

ENTRYPOINT ["bash", "scripts/start_pipeline.sh"]
