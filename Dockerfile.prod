FROM nvidia/cuda:12.6.0-devel-ubuntu22.04

RUN apt update && apt install -y \
    python3 \
    python3-venv \
    rsync \
    rclone \
    openssh-client \
    && rm -rf /var/lib/apt/lists/*

COPY bin/ffmpeg /usr/local/bin/ffmpeg
COPY bin/ffprobe /usr/local/bin/ffprobe
RUN chmod +x /usr/local/bin/ffmpeg /usr/local/bin/ffprobe

WORKDIR /app

# A venv vem antes do "COPY . .": o Docker reaproveita as camadas de cima para baixo até a primeira que
# mudou e refaz todas as seguintes. Com o COPY antes, qualquer mudança num script reinstalava o torch
# (camada de 7 GB a cada build, que lotou o disco). O .venv está no .dockerignore, o COPY não a sobrescreve.
RUN python3 -m venv .venv && \
    .venv/bin/pip install -U pip setuptools wheel && \
    .venv/bin/pip install torch==2.5.1 torchaudio==2.5.1 --index-url https://download.pytorch.org/whl/cu121 && \
    .venv/bin/pip install demucs==4.1.0 && \
    .venv/bin/pip install soundfile==0.14.0

COPY . .

ENTRYPOINT ["bash", "scripts/start_pipeline.sh"]
